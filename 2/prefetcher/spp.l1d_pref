#include "cache.h"

// we maintain two tables:
// IP table: per-IP last line, last stride, stride confidence and a
// signature (a hash of that IP's recent strides).
// Pattern table: shared, indexed by signature ^ IP bits, gives the stride
// that followed that history (so it's not fully exclusive per IP).
//
// uniform strides are prefetched first; we fall back to the pattern table
// when it confidently predicts a different stride, or there is no uniform
// stride. degree is set from the measured accuracy (our own issued /
// useful counters) every THROTTLE_WINDOW issued prefetches. prefetches never
// cross the 4 KB page.


#ifndef IPT_SIZE
#define IPT_SIZE 64
#endif
#define IPT_TAG_BITS 16
#define LINE_BITS 16
#define STRIDE_BITS 7
#define MAX_STRIDE ((1 << (STRIDE_BITS - 1)) - 1)
#define CONF_MAX 3
// strides seen in a row (minus one) before trusting a uniform stride
#ifndef UNI_CONF
#define UNI_CONF 1
#endif
#ifndef SIG_BITS
#define SIG_BITS 12
#endif
#define SIG_SHIFT 3
#define SIG_MASK ((1 << SIG_BITS) - 1)
#ifndef PT_BITS
#define PT_BITS 10
#endif
#define PT_SIZE (1 << PT_BITS)
#ifndef NU_CONF
#define NU_CONF 2
#endif
// recently issued prefetches, to avoid issuing the same line again
#ifndef FILTER_SIZE
#define FILTER_SIZE 32
#endif
#define FILTER_TAG_BITS 16

// accuracy checker: lines we prefetched recently, to see if a demand access
// uses them later
#ifndef PFT_SIZE
#define PFT_SIZE 128
#endif

// accuracy throttling: degree per accuracy range (percent)
#ifndef THROTTLE_WINDOW
#define THROTTLE_WINDOW 256
#endif
#ifndef ACC_LO
#define ACC_LO 25
#endif
#ifndef ACC_MID
#define ACC_MID 50
#endif
#ifndef ACC_HI
#define ACC_HI 75
#endif
#ifndef DEG_LO
#define DEG_LO 1
#endif
#ifndef DEG_MID
#define DEG_MID 2
#endif
#ifndef DEG_HI
#define DEG_HI 4
#endif
#ifndef DEG_MAX
#define DEG_MAX 6
#endif
#ifndef DEG_INIT
#define DEG_INIT 2
#endif

#define LINES_PER_PAGE_BITS (LOG2_PAGE_SIZE - LOG2_BLOCK_SIZE)

struct ipt_entry {
    bool valid;
    uint32_t tag;        // IPT_TAG_BITS
    uint32_t last_line;  // LINE_BITS low bits of the line address
    int32_t last_stride; // STRIDE_BITS, signed
    uint32_t conf;       // 2 bits
    uint32_t sig;        // SIG_BITS
    uint32_t lru;        // log2(IPT_SIZE) bits
};

struct pt_entry {
    int32_t stride;      // STRIDE_BITS, signed
    uint32_t conf;       // 2 bits
};

static ipt_entry ipt[IPT_SIZE];
static pt_entry pt[PT_SIZE];
static uint32_t filter[FILTER_SIZE];
static bool filter_valid[FILTER_SIZE];
static uint32_t filter_head;

static uint32_t pft[PFT_SIZE];
static bool pft_valid[PFT_SIZE];
static uint32_t pft_head;

static uint32_t degree = DEG_INIT;
// issued / useful prefetches in the current throttle window
static uint32_t win_issued, win_useful;

// stats
static uint64_t uni_pf, nu_pf, filtered;
static uint64_t windows_at[DEG_MAX + 1];

// folds the 64-bit IP down. the low 16 bits are the IP table tag, and the
// same hash is xor-ed into the pattern table index
static uint32_t ip_hash(uint64_t ip)
{
    return (uint32_t)(ip ^ (ip >> 16) ^ (ip >> 32) ^ (ip >> 48));
}

// new signature = old one shifted by 3, xor the new stride (7 bits). so it
// remembers the last few strides, older ones fall off the top
static uint32_t next_sig(uint32_t sig, int32_t stride)
{
    uint32_t s = (uint32_t)stride & ((1 << STRIDE_BITS) - 1);
    return ((sig << SIG_SHIFT) ^ s) & SIG_MASK;
}

// pattern table index: signature folded to PT_BITS, xor IP bits. so the same
// history seen by two different IPs mostly lands in different entries
static uint32_t pt_index(uint32_t sig, uint32_t iph)
{
    return (sig ^ (sig >> PT_BITS) ^ iph) & (PT_SIZE - 1);
}

// are line addresses a and b in the same 4 KB page
static bool same_page(uint64_t a, uint64_t b)
{
    return (a >> LINES_PER_PAGE_BITS) == (b >> LINES_PER_PAGE_BITS);
}

// finds the entry for this IP tag. on a miss, gives the LRU entry instead
// (*hit says which). either way that entry becomes MRU
static ipt_entry *ipt_lookup(uint32_t tag, bool *hit)
{
    int way = -1;
    for (int i = 0; i < IPT_SIZE; i++)
        if (ipt[i].valid && ipt[i].tag == tag)
            way = i;
    *hit = way >= 0;
    if (!*hit)
        for (int i = 0; i < IPT_SIZE; i++)
            if (ipt[i].lru == IPT_SIZE - 1)
                way = i;
    for (int i = 0; i < IPT_SIZE; i++)
        if (ipt[i].lru < ipt[way].lru)
            ipt[i].lru++;
    ipt[way].lru = 0;
    return &ipt[way];
}

// FILTER_TAG_BITS-bit tag of a line, for the filter and the accuracy checker
static uint32_t line_tag(uint64_t line)
{
    return (uint32_t)(line ^ (line >> FILTER_TAG_BITS))
           & ((1 << FILTER_TAG_BITS) - 1);
}

// true if we prefetched this line recently, else remembers it. without this,
// a stream sends the same lines again on every access (line + 2*stride now
// was line + 3*stride last time)
static bool filter_check(uint64_t line)
{
    uint32_t tag = line_tag(line);
    for (int i = 0; i < FILTER_SIZE; i++)
        if (filter_valid[i] && filter[i] == tag)
            return true;
    filter[filter_head] = tag;
    filter_valid[filter_head] = true;
    filter_head = (filter_head + 1) % FILTER_SIZE;
    return false;
}

// accuracy (%) of the last window -> prefetch degree, see ACC_* / DEG_*
// remember a line we just prefetched (FIFO, oldest one falls out)
static void pft_record(uint64_t line)
{
    pft[pft_head] = line_tag(line);
    pft_valid[pft_head] = true;
    pft_head = (pft_head + 1) % PFT_SIZE;
}

// a demand access to a line we prefetched: that prefetch was useful. the
// entry is dropped so it's counted only once
static bool pft_hit(uint64_t line)
{
    uint32_t tag = line_tag(line);
    for (int i = 0; i < PFT_SIZE; i++)
        if (pft_valid[i] && pft[i] == tag) {
            pft_valid[i] = false;
            return true;
        }
    return false;
}

static uint32_t degree_for(uint64_t acc)
{
    if (acc < ACC_LO)
        return DEG_LO;
    if (acc < ACC_MID)
        return DEG_MID;
    if (acc < ACC_HI)
        return DEG_HI;
    return DEG_MAX;
}

void CACHE::l1d_prefetcher_initialize()
{
    cout << "CPU " << cpu << " L1D Stride Pattern Prefetcher (SPP)" << endl;

    for (int i = 0; i < IPT_SIZE; i++) {
        ipt[i].valid = false;
        ipt[i].lru = i;
    }
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip, uint8_t cache_hit, uint8_t type, uint8_t critical_ip_flag)
{
    // only demand loads/stores train. prefetch requests come here too, but
    // training on them would be learning from our own guesses
    if (type != LOAD && type != RFO)
        return;

    uint64_t line = addr >> LOG2_BLOCK_SIZE;

    // accuracy checker: a demand access to a line we prefetched -> useful.
    // once THROTTLE_WINDOW prefetches are issued, accuracy = useful / issued
    // of that window picks the degree, and both counters start over
    if (pft_hit(line))
        win_useful++;
    if (win_issued >= THROTTLE_WINDOW) {
        uint64_t acc = 100 * (uint64_t)win_useful / win_issued;
        windows_at[degree]++;
        degree = degree_for(acc);
        win_issued = 0;
        win_useful = 0;
    }
    uint32_t iph = ip_hash(ip);
    uint32_t tag = iph & ((1 << IPT_TAG_BITS) - 1);
    uint32_t low = line & ((1 << LINE_BITS) - 1);

    bool hit = false;
    ipt_entry *e = ipt_lookup(tag, &hit);
    // new IP, nothing to compare with yet
    if (!hit) {
        e->valid = true;
        e->tag = tag;
        e->last_line = low;
        e->last_stride = 0;
        e->conf = 0;
        e->sig = 0;
        return;
    }

    // we keep only LINE_BITS low bits of the last line, so the stride is
    // their difference, sign-extended. same line again tells us nothing
    int32_t stride = (int16_t)(uint16_t)(low - e->last_line);
    if (stride == 0)
        return;
    e->last_line = low;

    // stride bigger than a page: can never prefetch with it, start over
    if (stride > MAX_STRIDE || stride < -MAX_STRIDE) {
        e->last_stride = 0;
        e->conf = 0;
        e->sig = 0;
        return;
    }

    // uniform: same stride as last time -> more confident, else less
    if (stride == e->last_stride) {
        if (e->conf < CONF_MAX)
            e->conf++;
    } else if (e->conf > 0) {
        e->conf--;
    }
    e->last_stride = stride;

    // pattern table: the old signature (history) was followed by this
    // stride. same stride as stored -> more confident, different -> less,
    // and the stored stride is replaced only once confidence hits 0
    pt_entry *p = &pt[pt_index(e->sig, iph)];
    if (p->stride == stride) {
        if (p->conf < CONF_MAX)
            p->conf++;
    } else if (p->conf > 0) {
        p->conf--;
    } else {
        p->stride = stride;
        p->conf = 1;
    }
    e->sig = next_sig(e->sig, stride);

    // uniform if the stride is repeating, unless the pattern table is sure
    // the next stride is different (the run is ending, eg. +2 +2 +2 then
    // +3). if not uniform, use the pattern table if it's confident
    pt_entry *next = &pt[pt_index(e->sig, iph)];
    bool nu_ok = next->conf >= NU_CONF;
    bool uni = e->conf >= UNI_CONF && !(nu_ok && next->stride != stride);
    if (!uni && !nu_ok)
        return;

    // into the L1D if its MSHR is less than half full, else only the L2C
    // (same as ip_stride)
    int fill = MSHR.occupancy < (MSHR.SIZE >> 1) ? FILL_L1 : FILL_L2;
    uint64_t pf_line = line;
    uint32_t sig = e->sig;
    // up to degree prefetches. uniform: line + stride, line + 2*stride, ...
    // non-uniform: walk the pattern table with a speculative signature,
    // stop at the first entry that isn't confident. never leave the page
    for (uint32_t i = 0; i < degree; i++) {
        int32_t s = stride;
        if (!uni) {
            pt_entry *q = &pt[pt_index(sig, iph)];
            if (q->conf < NU_CONF)
                break;
            s = q->stride;
            sig = next_sig(sig, s);
        }
        pf_line += s;
        if (!same_page(pf_line, line))
            break;
        if (filter_check(pf_line)) {
            filtered++;
            continue;
        }
        if (!prefetch_line(ip, addr, pf_line << LOG2_BLOCK_SIZE, fill, 0))
            break;
        pft_record(pf_line);
        win_issued++;
        if (uni)
            uni_pf++;
        else
            nu_pf++;
    }
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr, uint32_t set, uint32_t way, uint8_t prefetch, uint64_t v_evicted_addr, uint64_t evicted_addr, uint32_t metadata_in)
{
	return; //metadata_in;
}

// prefetches issued by each path, and how many windows ran at each degree
// (both include warmup)
void CACHE::l1d_prefetcher_final_stats()
{
    cout << "L1D SPP uniform prefetches: " << uni_pf
         << " non-uniform prefetches: " << nu_pf
         << " filtered: " << filtered << " final degree: " << degree
         << endl;
    cout << "L1D SPP throttle windows per degree:";
    for (int d = 1; d <= DEG_MAX; d++)
        cout << " " << d << ":" << windows_at[d];
    cout << endl;
}
